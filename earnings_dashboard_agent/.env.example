PORT=8000
WATCHLIST_PATH=config/watchlist.csv
DATA_DB_PATH=data/earnings.db
ENABLE_SCHEDULER=true
MARKET_POLL_MINUTES=5
DATA_MIN_REQUEST_INTERVAL=1.2

# Groq is the default hosted free-tier provider. Alternatives: gemini, openrouter, ollama.
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Optional Finnhub EPS consensus; unavailable fields remain N/A without this key.
FINNHUB_API_KEY=
FINNHUB_SYMBOL_FORMAT={symbol}

# Optional SMTP alerts / digest
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL=
DIGEST_HOUR_IST=16
DIGEST_MINUTE_IST=0
LOG_LEVEL=INFO
LOG_LEVEL=INFO